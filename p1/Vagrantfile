BOX = "debian/bookworm64"

SERVER_NAME = "abquaoubS"
SERVER_IP   = "192.168.56.110"

WORKER_NAME = "abquaoubSW"
WORKER_IP   = "192.168.56.111"

CPUS   = 1
MEMORY = 1024

SERVER_SCRIPT = "scripts/server.sh"
WORKER_SCRIPT = "scripts/worker.sh"

PROVIDER = "virtualbox"

Vagrant.configure("2") do |config|

  config.vm.box = BOX

  # Shared between host, server and worker.
  # Used to transfer the K3s token.
  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

  # =========================
  # Server
  # =========================

  config.vm.define SERVER_NAME do |server|

    server.vm.hostname = SERVER_NAME

    server.vm.network "private_network",
      ip: SERVER_IP

    server.vm.provider PROVIDER do |vb|
      vb.name   = SERVER_NAME
      vb.cpus   = CPUS
      vb.memory = MEMORY
    end

    server.vm.provision "shell",
      path: SERVER_SCRIPT
  end

  # =========================
  # Worker
  # =========================

  config.vm.define WORKER_NAME do |worker|

    worker.vm.hostname = WORKER_NAME

    worker.vm.network "private_network",
      ip: WORKER_IP

    worker.vm.provider PROVIDER do |vb|
      vb.name   = WORKER_NAME
      vb.cpus   = CPUS
      vb.memory = MEMORY
    end

    worker.vm.provision "shell",
      path: WORKER_SCRIPT
  end

end