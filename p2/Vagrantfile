BOX = "debian/bookworm64"

SERVER_NAME = "abquaoubS"
SERVER_IP   = "192.168.56.110"

CPUS   = 1
MEMORY = 1024

SERVER_SCRIPT = "scripts/server.sh"

PROVIDER = "virtualbox"

Vagrant.configure("2") do |config|

  config.vm.box = BOX

  config.vm.synced_folder ".", "/vagrant",
    type: "virtualbox"

  config.vm.define SERVER_NAME do |server|

    server.vm.hostname = SERVER_NAME

    server.vm.network "private_network",
      ip: SERVER_IP

    server.vm.provider PROVIDER do |vb|
      vb.name   = SERVER_NAME
      vb.cpus   = CPUS
      vb.memory = MEMORY
    end

    # Copy Kubernetes configs first
    server.vm.provision "file",
      source: "confs",
      destination: "/home/vagrant/confs"

    # Then install K3s and deploy them
    server.vm.provision "shell",
      path: SERVER_SCRIPT

  end

end